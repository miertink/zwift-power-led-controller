#pragma once

// Copy this file to config.h and fill in your real credentials.
// config.h is gitignored so your credentials never get committed.

// Wi-Fi (optional - only used for status telemetry, fan control doesn't need it)
#define WIFI_SSID "yourwifissid"
#define WIFI_PASSWORD "yourwifipassword"

// MQTT broker (fan control never depends on this - BLE is the sole source of truth there)
#define MQTT_HOST "ipofyourmqttbroker"
#define MQTT_PORT 1883
#define MQTT_LOGIN "user"
#define MQTT_PASSWORD "password"
#define MQTT_CLIENT_ID "fan-dimmer"
#define MQTT_STATUS_TOPIC "tele/FanDimmer/status"
#define MQTT_ENABLE_ALL_TOPIC "cmnd/led-st/led_enableAll"
#define MQTT_DIMMER_TOPIC "cmnd/led-st/led_dimmer"
#define MQTT_BASE_COLOR_TOPIC "cmnd/led-st/led_basecolor_rgb"
// Remote on/off override for the fan (e.g. a Home Assistant MQTT switch)
#define MQTT_FAN_POWER_COMMAND_TOPIC "cmnd/FanDimmer/power"
#define MQTT_FAN_POWER_STATE_TOPIC "stat/FanDimmer/power"

// Leave HRM_MAC_ADDRESS empty to accept the first Heart Rate Service (0x180D) found, or
// pin it (e.g. "AA:BB:CC:DD:EE:FF") to one specific strap.
#define HRM_MAC_ADDRESS ""

// Fan speed curve: linear mapping from BPM to fan duty cycle (%)
#define HRM_BASE_SPEED 50  // Duty cycle at/below HRM_MIN_BPM
#define HRM_MIN_BPM 100    // Below this the fan turns off entirely
#define HRM_MAX_BPM 160    // BPM at/above which the fan sits at HRM_MAX_SPEED
// Keep a few % below 100 - too close to full conduction, an inductive motor load may not
// latch reliably. If your fan has its own manual speed switch, re-measure the safe ceiling
// per position (85 is confirmed on the reference hardware's "High" position).
#define HRM_MAX_SPEED 85

// Once running, the fan only turns off after dropping this many BPM below HRM_MIN_BPM -
// avoids clicking on/off when BPM hovers right around the threshold.
#define HRM_HYSTERESIS_BPM 5

// Heart rate reading is treated as stale after this long without a new notification
#define HRM_STALE_TIMEOUT_MS 15000

// HR zone boundaries (BPM) driving the RGB LED color: grey (rest)/blue/green/yellow/orange/tomato
#define HR_ZONE1_MIN 100
#define HR_ZONE2_MIN 120
#define HR_ZONE3_MIN 138
#define HR_ZONE4_MIN 150
#define HR_ZONE5_MIN 163

// AC dimmer wiring (RobotDyn AC Light Dimmer module) - ESP32-WROOM DevKit GPIO numbers
#define DIMMER_OUTPUT_PIN 26 // TRIAC gate (PSM) pin
#define DIMMER_ZC_PIN 27     // Zero-cross detection pin (must support interrupts)

// Status LEDs (active HIGH: GPIO -> resistor -> LED anode -> cathode -> GND)
#define STATUS_LED_PIN 32 // Blinks while scanning/connecting to the HRM strap, solid ON once connected
#define FAN_LED_PIN 33    // Blinks at a rate proportional to the fan speed
